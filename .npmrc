# Resolve peer dependencies strictly for this project, regardless of any
# user-level ~/.npmrc. `legacy-peer-deps=true` in a developer's global config
# changes how npm marks peer-only packages (typescript, @types/react, playwright,
# ...) as dev/devOptional, so machines with and without it rewrite
# package-lock.json back and forth. Fury resolves cleanly with strict peers.
legacy-peer-deps=false
